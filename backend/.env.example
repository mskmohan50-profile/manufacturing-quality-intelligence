# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/manufacturing_quality?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# How long a login session (JWT) stays valid
JWT_EXPIRES_IN=7d

# Port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
